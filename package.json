{
  "name": "walk-wokeliu-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Walk 我可遛 MVP — 雙向媒合遛狗平台",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,yellow \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch-path=server --disable-warning=ExperimentalWarning server/index.js",
    "dev:web": "vite",
    "seed": "node --disable-warning=ExperimentalWarning server/seed.js",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "share": "vite build && npm run start",
    "tunnel": "node scripts/tunnel.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^5.4.11"
  }
}
